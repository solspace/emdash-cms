---
import DemoShell from "../layouts/DemoShell.astro";
import { FreeformForm } from "@solspace/freeform-astro/components";
---

<DemoShell
	title="Simple embed | Freeform Demo"
	active="demo"
	navSentence="This section has automatically loaded a simple <b>Contact</b> form embed."
>
	<div class="freeform-page-heading">
		<h2>Simple embed</h2>
		<p>
			Minimal page with a single <code>&lt;FreeformForm formId="contact" /&gt;</code>.
		</p>
	</div>

	<div class="demo-card">
		<FreeformForm formId="contact" />
	</div>
</DemoShell>

<style>
	.demo-card {
		max-width: 640px;
		padding: 1.5rem;
		border: 1px solid #e5e7eb;
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 1px 3px rgb(0 0 0 / 5%);
	}
</style>

<style is:global>
	[data-freeform-form] {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-family: sans-serif;
	}
	[data-freeform-row] {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	[data-freeform-field] {
		flex: 1;
		min-width: 12rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	[data-freeform-field] label {
		font: 500 13px sans-serif;
		color: #374151;
	}
	[data-freeform-input] {
		width: 100%;
		padding: 0.5rem 0.65rem;
		border: 1px solid #d1d5db;
		border-radius: 6px;
		font: 400 14px sans-serif;
		box-sizing: border-box;
	}
	[data-freeform-input]:focus {
		outline: none;
		border-color: #86b7fe;
		box-shadow: 0 0 0 3px rgb(13 110 253 / 20%);
	}
	textarea[data-freeform-input] {
		min-height: 6rem;
		resize: vertical;
	}
	[data-freeform-submit] {
		align-self: flex-start;
		padding: 0.5rem 1.1rem;
		background: #0d6efd;
		color: #fff;
		border: none;
		border-radius: 6px;
		font: 500 14px sans-serif;
		cursor: pointer;
	}
	[data-freeform-required-mark] {
		color: #dc3545;
	}
</style>
