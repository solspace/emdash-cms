---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import DemoShell from "../layouts/DemoShell.astro";
import { FreeformForm, FreeformChat } from "@solspace/freeform-astro/components";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");
if (Astro.cache?.enabled && page) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = page
	? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/contact" })
	: {
			title: `Contact | Freeform Demo`,
			ogTitle: null,
			description: null,
			canonical: null,
			ogImage: null,
		};

const salesContext = `Solspace Freeform for EmDash is a form builder plugin: create forms in the EmDash admin, embed them with @solspace/freeform-astro, collect submissions, send email notifications, and deliver signed webhooks.

This page is a public demo. Visitors may ask about form builder features, AI generate, spam scoring, Turnstile, notifications, webhooks, CSV export, or privacy/retention tooling.

Tone: helpful and direct. Gather enough detail for a Solspace teammate to follow up — don't invent product claims.`;
---

<DemoShell
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	active="forms"
	navSentence="This section has automatically loaded the <b>Contact</b> form."
	content={page ? { collection: "pages", id: page.data.id, slug: "contact" } : undefined}
>
	<div class="freeform-page-heading">
		<h2>Contact</h2>
		<p>
			Same form handle for chat and embed — submissions land in Freeform → Submissions.
		</p>
	</div>

	{
		page && (
			<div class="contact-lede">
				<PortableText value={page.data.content} />
			</div>
		)
	}

	<div class="contact-grid">
		<section class="contact-col">
			<h3>AI chat</h3>
			<p class="col-blurb">
				FreeformChat collects answers conversationally and can submit the contact form.
			</p>
			<FreeformChat
				formHandle="contact"
				siteName="Solspace Freeform"
				salesContext={salesContext}
			/>
		</section>

		<section class="contact-col">
			<h3>Form</h3>
			<p class="col-blurb">
				Standard <code>&lt;FreeformForm /&gt;</code> embed.
			</p>
			<FreeformForm formId="contact" />
		</section>
	</div>
</DemoShell>

<style>
	.contact-lede {
		margin: 0 0 2rem;
		color: var(--page-text);
		max-width: 40rem;
		line-height: 1.5;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: start;
	}
	.contact-col {
		min-width: 0;
	}
	.contact-col h3 {
		font: 600 18px sans-serif;
		color: var(--page-text);
		margin: 0 0 0.5rem;
	}
	.col-blurb {
		font: 400 14px/1.45 sans-serif;
		color: var(--nav-text);
		margin: 0 0 1rem;
	}
	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<style is:global>
	/* Light Craft-demo-friendly Freeform defaults */
	[data-freeform-form] {
		--ff-accent: #0d6efd;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 560px;
		font-family: sans-serif;
	}
	[data-freeform-row] {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	[data-freeform-field] {
		flex: 1;
		min-width: 12rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	[data-freeform-field] label,
	[data-freeform-group-label] {
		font: 500 13px sans-serif;
		color: var(--page-text, #4e4e4e);
	}
	[data-freeform-required-mark] {
		color: #dc3545;
	}
	[data-freeform-input] {
		width: 100%;
		padding: 0.5rem 0.65rem;
		border: 1px solid #ced4da;
		border-radius: 6px;
		font: 400 14px sans-serif;
		color: #212529;
		background: #fff;
		box-sizing: border-box;
	}
	[data-freeform-input]:focus {
		outline: none;
		border-color: #86b7fe;
		box-shadow: 0 0 0 3px rgb(13 110 253 / 20%);
	}
	textarea[data-freeform-input] {
		min-height: 6rem;
		resize: vertical;
	}
	[data-freeform-submit] {
		align-self: flex-start;
		padding: 0.5rem 1.1rem;
		background: #0d6efd;
		color: #fff;
		border: none;
		border-radius: 6px;
		font: 500 14px sans-serif;
		cursor: pointer;
	}
	[data-freeform-submit]:hover:not(:disabled) {
		background: #0b5ed7;
	}
	[data-freeform-options] {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	[data-freeform-option] {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font: 400 14px sans-serif;
		color: var(--page-text, #4e4e4e);
	}

	[data-freeform-chat] {
		max-width: 560px;
	}
	[data-freeform-chat-frame] {
		border: 1px solid #ced4da;
		border-radius: 10px;
		background: #fff;
		display: flex;
		flex-direction: column;
		min-height: 360px;
		overflow: hidden;
	}
	[data-freeform-chat-header] {
		font: 500 12px sans-serif;
		color: #6c757d;
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid #e9ecef;
		background: #f8f9fa;
	}
	[data-freeform-chat-log] {
		flex: 1;
		padding: 1rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		min-height: 220px;
		max-height: 420px;
	}
	[data-freeform-chat-message] {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	[data-freeform-chat-message][data-freeform-chat-role="user"] {
		align-items: flex-end;
	}
	[data-freeform-chat-label] {
		font: 500 11px sans-serif;
		color: #adb5bd;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	[data-freeform-chat-bubble] {
		font: 400 14px/1.5 sans-serif;
		color: #212529;
		background: #f1f3f5;
		padding: 0.55rem 0.75rem;
		border-radius: 10px;
		max-width: 85%;
	}
	[data-freeform-chat-message][data-freeform-chat-role="user"] [data-freeform-chat-bubble] {
		background: #e7f1ff;
		color: #084298;
	}
	[data-freeform-chat-input] {
		display: grid;
		grid-template-columns: 1fr auto;
		border-top: 1px solid #e9ecef;
	}
	[data-freeform-chat-input] textarea {
		border: 0;
		padding: 0.75rem;
		font: 400 14px sans-serif;
		resize: vertical;
		outline: none;
	}
	[data-freeform-chat-input] button {
		border: 0;
		border-left: 1px solid #e9ecef;
		background: #0d6efd;
		color: #fff;
		padding: 0 1.1rem;
		font: 500 13px sans-serif;
		cursor: pointer;
	}
	[data-freeform-chat-input] button:hover {
		background: #0b5ed7;
	}
	[data-freeform-chat-input] button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
</style>
