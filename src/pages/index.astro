---
/**
 * Home = live Freeform demo (Craft freeform-demo style): sticky nav + form.
 */
import DemoShell from "../layouts/DemoShell.astro";
import { FreeformForm } from "@solspace/freeform-astro/components";
---

<DemoShell
	title="Freeform Demo"
	active="forms"
	navSentence="This section has automatically loaded the <b>Contact</b> form."
>
	<div class="freeform-page-heading">
		<h2>Contact</h2>
		<p>Solspace Freeform on EmDash — try the form below.</p>
	</div>

	<div class="demo-form">
		<FreeformForm formId="contact" />
	</div>
</DemoShell>

<style>
	.demo-form {
		max-width: 640px;
	}
</style>

<style is:global>
	[data-freeform-form] {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-family: sans-serif;
	}
	[data-freeform-row] {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	[data-freeform-field] {
		flex: 1;
		min-width: 12rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	[data-freeform-field] label,
	[data-freeform-group-label] {
		font: 500 13px sans-serif;
		color: var(--page-text, #4e4e4e);
	}
	[data-freeform-required-mark] {
		color: #dc3545;
	}
	[data-freeform-input] {
		width: 100%;
		padding: 0.5rem 0.65rem;
		border: 1px solid #ced4da;
		border-radius: 6px;
		font: 400 14px sans-serif;
		color: #212529;
		background: #fff;
		box-sizing: border-box;
	}
	[data-freeform-input]:focus {
		outline: none;
		border-color: #86b7fe;
		box-shadow: 0 0 0 3px rgb(13 110 253 / 20%);
	}
	textarea[data-freeform-input] {
		min-height: 6rem;
		resize: vertical;
	}
	[data-freeform-options] {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	[data-freeform-option] {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font: 400 14px sans-serif;
	}
	[data-freeform-submit] {
		align-self: flex-start;
		padding: 0.5rem 1.1rem;
		background: #0d6efd;
		color: #fff;
		border: none;
		border-radius: 6px;
		font: 500 14px sans-serif;
		cursor: pointer;
	}
	[data-freeform-submit]:hover:not(:disabled) {
		background: #0b5ed7;
	}
</style>
