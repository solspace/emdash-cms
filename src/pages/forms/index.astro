---
import { env } from "cloudflare:workers";
import DemoShell from "../../layouts/DemoShell.astro";

export const prerender = false;

interface PublicForm {
	id: string;
	handle: string;
	name: string;
	cardColor?: string | null;
}

let forms: PublicForm[] = [];
const fetcher = (env as any).SELF ?? globalThis;
try {
	const res = await fetcher.fetch(
		`${Astro.url.origin}/_emdash/api/plugins/freeform/list-public-forms`,
	);
	if (res.ok) {
		const json = (await res.json()) as { data?: { forms?: PublicForm[] } };
		forms = json.data?.forms ?? [];
	}
} catch {
	forms = [];
}

const formCount = forms.length;
---

<DemoShell title="Forms | Freeform Demo" active="forms">
	<section
		class="freeform-form-browser"
		data-form-browser
		data-view="cards"
		aria-labelledby="browser-title"
	>
		<div class="freeform-browser-heading">
			<div>
				<div class="freeform-browser-title-row">
					<h2 id="browser-title">Choose a form</h2>
					<span class="freeform-browser-total"
						>{formCount} {formCount === 1 ? "form" : "forms"}</span
					>
				</div>
				<p>Public Freeform forms on this EmDash site. Open one to try it live.</p>
			</div>
		</div>

		{
			formCount ? (
				<div class="freeform-browser-items" id="browser-items">
					{forms.map((form) => (
						<article
							class="freeform-browser-item freeform-form-card"
							style={`--form-accent: ${form.cardColor || "#3976db"}`}
							data-browser-item
						>
							<span class="freeform-browser-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<rect x="3" y="5" width="18" height="14" rx="2" />
									<path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<div class="freeform-browser-summary">
								<h3>{form.name}</h3>
								<p>
									<code>{form.handle}</code>
								</p>
							</div>
							<div class="freeform-browser-footer">
								<a
									class="freeform-browser-open"
									href={`/forms/${form.handle}`}
									aria-label={`Try form: ${form.name}`}
								>
									Try form{" "}
									<svg
										viewBox="0 0 20 20"
										fill="none"
										stroke="currentColor"
										stroke-width="1.6"
										aria-hidden="true"
									>
										<path
											d="M4 10h12m-5-5 5 5-5 5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</a>
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="freeform-browser-empty">
					<h3>No forms yet</h3>
					<p>
						Create a form in the EmDash admin (Freeform) to see it here. The seeded{" "}
						<code>contact</code> form appears after install.
					</p>
					<p>
						<a href="/contact">Open contact demo</a> ·{" "}
						<a href="/_emdash/admin">Open admin</a>
					</p>
				</div>
			)
		}
	</section>
</DemoShell>
