{
  "name": "@solspace/emdash-cms",
  "version": "1.1.0",
  "private": true,
  "description": "Solspace example EmDash site with Freeform — forms, AI chat intake, and Cloudflare deploy.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/solspace/emdash-cms.git"
  },
  "bugs": {
    "url": "https://github.com/solspace/emdash-cms/issues"
  },
  "homepage": "https://github.com/solspace/emdash-cms#readme",
  "license": "MIT",
  "keywords": [
    "emdash",
    "freeform",
    "solspace",
    "astro",
    "cloudflare",
    "cms",
    "forms"
  ],
  "emdash": {
    "label": "Freeform Demo (EmDash)",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/sync-freeform.mjs --build --clean && astro dev --host 127.0.0.1 --port 4321",
    "dev:astro": "astro dev --host 127.0.0.1 --port 4321",
    "freeform:sync": "node scripts/sync-freeform.mjs --build --clean",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check"
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.0",
    "@astrojs/react": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emdash-cms/cloudflare": "^1.3.1",
    "@local/freeform": "file:../freeform",
    "@solspace/freeform-astro": "file:../freeform/packages/astro",
    "astro": "^6.4.2",
    "emdash": "^1.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^4.20260305.1",
    "wrangler": "^4.151.3"
  }
}
