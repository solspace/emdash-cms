{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "freeform-demo",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "emdash.solspace.net",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "freeform-demo",
			"database_id": "65cc710d-13bc-4e6a-bec8-5d03257b7fcf",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "freeform-demo-media",
		},
	],
	// Astro Cloudflare sessions — reuse namespace from first deploy
	// (retry auto-provision fails: title already exists).
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "47a44950593f49e3979559f2067ebbee",
		},
	],
	// Worker Loader (LOADER) requires Cloudflare Workers Paid / Dynamic Workers.
	// Omit on free plans — trusted plugins (freeformPlugin()) still run; registry
	// sandbox installs stay disabled until the account is upgraded.
	// Self-binding so the MCP handler can invoke plugin routes in-process.
	// Cloudflare blocks workers from making HTTP fetches to their own hostname;
	// env.SELF.fetch() dispatches directly to the worker handler instead.
	"services": [
		{
			"binding": "SELF",
			"service": "freeform-demo",
		},
	],
	// EmDash email pipeline (invites, magic links, Freeform notifications).
	// Sender domain must be onboarded for Cloudflare Email Sending on this
	// account — see README. From address is set in astro.config.mjs.
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
}
