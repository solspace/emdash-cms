# Copy to .env / .dev.vars as needed for your EmDash + Cloudflare setup.
# Never commit real secrets.

# Optional: OpenAI key can also be stored in Freeform → Settings → AI & spam
# OPENAI_API_KEY=

# Cloudflare (production / Wrangler) — see wrangler.jsonc
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
