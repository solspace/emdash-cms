---
import { getMenu, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { FreeformDiscovery } from "@solspace/freeform-astro/components";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#0f172a" />
		<EmDashHead page={pageCtx} />
		<FreeformDiscovery />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<a href="/" class="brand" aria-label={siteTitle}>
				<img src="/favicon.svg" width="36" height="36" alt="" />
				<span>Solspace Freeform</span>
			</a>
			<nav class="primary-nav" aria-label="Primary">
				{menu?.items.map((item) => (
					<a href={item.url} target={item.target}>
						{item.label}
					</a>
				))}
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-row">
				<div>
					<strong>Freeform for EmDash</strong>
					<p>Build forms, collect submissions, send notifications, and fire webhooks.</p>
				</div>
				<div class="footer-links">
					<a href="/contact">Contact form</a>
					<a href="/demo">Simple embed</a>
					<a href="/_emdash/admin">Admin</a>
					<a href="https://plugins.emdashcms.com/plugins/@solspace.com/freeform">Registry</a>
					<a href="https://github.com/solspace/emdash-freeform">GitHub</a>
				</div>
				<div class="widget-block">
					<WidgetArea name="sidebar" />
				</div>
			</div>
			<div class="footer-bottom">
				<span>© {year} Solspace</span>
				<span>
					Machine-readable: <a href="/llms.txt">/llms.txt</a>
				</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script is:inline>
			(function () {
				try {
					const key = "ff_journey";
					const max = 25;
					const desc = document.querySelector('meta[name="description"]');
					const entry = {
						url: location.pathname + location.search,
						title: document.title,
						description: desc ? desc.getAttribute("content") : null,
						visitedAt: new Date().toISOString(),
					};
					const raw = localStorage.getItem(key);
					const list = raw ? JSON.parse(raw) : [];
					if (!list.length || list[list.length - 1].url !== entry.url) {
						list.push(entry);
					}
					while (list.length > max) list.shift();
					localStorage.setItem(key, JSON.stringify(list));
				} catch (_) {}
			})();
		</script>

		<style is:global>
			:root {
				--demo-bg: #0f172a;
				--demo-bg-elev: #1e293b;
				--demo-fg: #f1f5f9;
				--demo-fg-muted: #94a3b8;
				--demo-fg-dim: #64748b;
				--demo-accent: #38bdf8;
				--demo-rule: #334155;
				--demo-rule-strong: #475569;

				/* Compat aliases for older page styles */
				--mrs-bg: var(--demo-bg);
				--mrs-bg-elev: var(--demo-bg-elev);
				--mrs-fg: var(--demo-fg);
				--mrs-fg-muted: var(--demo-fg-muted);
				--mrs-fg-dim: var(--demo-fg-dim);
				--mrs-accent: var(--demo-accent);
				--mrs-rule: var(--demo-rule);
				--mrs-rule-strong: var(--demo-rule-strong);

				--font-display: "Segoe UI", system-ui, -apple-system, sans-serif;
				--font-body: "Segoe UI", system-ui, -apple-system, sans-serif;
				--font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
			}

			* { box-sizing: border-box; }

			html, body {
				margin: 0;
				min-height: 100%;
				font-family: var(--font-body);
				background:
					radial-gradient(ellipse 70% 45% at 50% -15%, rgb(56 189 248 / 16%), transparent),
					var(--demo-bg);
				color: var(--demo-fg);
				font-size: 16px;
				line-height: 1.55;
				-webkit-font-smoothing: antialiased;
			}

			body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			a { color: var(--demo-accent); text-decoration: none; }
			a:hover { text-decoration: underline; }

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				flex-wrap: wrap;
				max-width: 960px;
				margin: 0 auto;
				padding: 1.25rem 1.25rem 0;
				width: 100%;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				color: var(--demo-fg);
				font-weight: 700;
				text-decoration: none;
			}
			.brand:hover { color: var(--demo-accent); text-decoration: none; }
			.brand img { display: block; border-radius: 0.4rem; }

			.primary-nav {
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
			}
			.primary-nav a {
				color: var(--demo-fg-muted);
				font-size: 0.9rem;
				font-weight: 600;
				text-decoration: none;
			}
			.primary-nav a:hover { color: var(--demo-accent); }

			main { flex: 1; width: 100%; }

			h1, h2, h3, h4 {
				font-family: var(--font-display);
				font-weight: 700;
				letter-spacing: -0.02em;
				line-height: 1.2;
				margin: 0 0 0.75rem;
				color: var(--demo-fg);
			}
			h1 { font-size: clamp(1.6rem, 4vw, 2.1rem); }
			h2 { font-size: 1.25rem; }
			p {
				margin: 0 0 1rem;
				max-width: 40rem;
				color: var(--demo-fg-muted);
			}

			.page {
				max-width: 960px;
				margin: 0 auto;
				padding: 2.5rem 1.25rem 4rem;
			}
			.page-header {
				margin-bottom: 2rem;
			}
			.page-header .eyebrow,
			.eyebrow {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--demo-fg-dim);
				margin-bottom: 0.5rem;
			}
			.page-meta {
				font-size: 0.85rem;
				color: var(--demo-fg-dim);
			}

			.site-footer {
				border-top: 1px solid var(--demo-rule);
				max-width: 960px;
				margin: 0 auto;
				padding: 2rem 1.25rem 2.5rem;
				width: 100%;
			}
			.footer-row {
				display: grid;
				grid-template-columns: 1.4fr 1fr auto;
				gap: 2rem;
				margin-bottom: 1.5rem;
			}
			.footer-row strong { color: var(--demo-fg); }
			.footer-row p {
				margin: 0.4rem 0 0;
				font-size: 0.9rem;
			}
			.footer-links {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}
			.footer-links a {
				color: var(--demo-fg-muted);
				font-size: 0.9rem;
			}
			.footer-links a:hover { color: var(--demo-accent); }
			.footer-bottom {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
				padding-top: 1rem;
				border-top: 1px solid var(--demo-rule);
				font-size: 0.8rem;
				color: var(--demo-fg-dim);
			}
			.footer-bottom a { color: var(--demo-fg-muted); }

			.accent { color: var(--demo-accent); }
			.mono { font-family: var(--font-mono); }

			@media (max-width: 720px) {
				.footer-row { grid-template-columns: 1fr; }
			}
		</style>
	</body>
</html>
